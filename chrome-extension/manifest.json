{
  "manifest_version": 3,
  "name": "YouTube Sentiment",
  "version": "1.1.0",
  "description": "Analyse du sentiment des commentaires YouTube.",
 "permissions": ["activeTab", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html"
  },
 "host_permissions": [
  "http://127.0.0.1/*",
  "https://supreme-telegram-g469prxwq6x52vqvq-7860.app.github.dev/*"
],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}